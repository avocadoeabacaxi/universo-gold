{
  "name": "DiscAssessment",
  "type": "object",
  "properties": {
    "candidate_name": {
      "type": "string",
      "description": "Nome de quem responde"
    },
    "candidate_email": {
      "type": "string",
      "description": "E-mail de quem responde"
    },
    "department": {
      "type": "string",
      "description": "Setor/Departamento"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "recrutamento",
        "desenvolvimento",
        "promocao",
        "autoconhecimento"
      ],
      "default": "desenvolvimento",
      "description": "Finalidade da avalia\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "invited_by_id": {
      "type": "string"
    },
    "invited_by_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que respondeu"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "most": {
            "type": "string"
          },
          "least": {
            "type": "string"
          }
        }
      }
    },
    "score_d": {
      "type": "number"
    },
    "score_i": {
      "type": "number"
    },
    "score_s": {
      "type": "number"
    },
    "score_c": {
      "type": "number"
    },
    "primary_profile": {
      "type": "string",
      "enum": [
        "D",
        "I",
        "S",
        "C"
      ]
    },
    "secondary_profile": {
      "type": "string",
      "enum": [
        "D",
        "I",
        "S",
        "C"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "hr_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do RH"
    },
    "ai_analysis": {
      "type": "object",
      "description": "An\u00e1lise direcionada gerada por IA conforme a finalidade"
    }
  },
  "required": [
    "candidate_name"
  ]
}