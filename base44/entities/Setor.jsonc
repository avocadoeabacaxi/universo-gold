{
  "name": "Setor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do setor"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do setor"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade \u00e0 qual o setor pertence"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ]
}