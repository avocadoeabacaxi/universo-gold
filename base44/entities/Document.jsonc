{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do documento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "file_type": {
      "type": "string",
      "description": "Extens\u00e3o do arquivo (pdf, docx, etc)"
    },
    "category": {
      "type": "string",
      "description": "Categoria do documento"
    },
    "community_id": {
      "type": "string",
      "description": "ID da comunidade (null = global)"
    },
    "community_name": {
      "type": "string",
      "description": "Nome da comunidade"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "all",
        "department",
        "admin"
      ],
      "default": "all",
      "description": "Quem pode visualizar"
    },
    "edit_access": {
      "type": "string",
      "enum": [
        "only_me",
        "editors",
        "admin"
      ],
      "default": "only_me",
      "description": "Quem pode editar/substituir"
    },
    "allowed_departments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Departamentos com acesso (se access_level=department)"
    },
    "password": {
      "type": "string",
      "description": "Senha de acesso ao documento (opcional)"
    },
    "uploader_id": {
      "type": "string",
      "description": "ID de quem fez upload"
    },
    "uploader_name": {
      "type": "string",
      "description": "Nome de quem fez upload"
    },
    "downloads_count": {
      "type": "number",
      "default": 0
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Vers\u00e3o do documento"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "title",
    "file_url"
  ]
}