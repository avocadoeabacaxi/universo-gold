{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (refer\u00eancia ao User)"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "email": {
      "type": "string",
      "description": "Email corporativo"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do colaborador"
    },
    "matricula": {
      "type": "string",
      "description": "N\u00famero de matr\u00edcula do colaborador"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status de autoriza\u00e7\u00e3o do cadastro pelo moderador"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "department_leader",
        "moderator",
        "user"
      ],
      "default": "user"
    },
    "department": {
      "type": "string",
      "description": "Departamento"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo"
    },
    "gestor": {
      "type": "string",
      "description": "Nome do gestor respons\u00e1vel"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "cover_url": {
      "type": "string",
      "description": "URL da imagem de capa do perfil"
    },
    "bio": {
      "type": "string",
      "description": "Breve bio"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "communities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das comunidades"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "email"
  ]
}