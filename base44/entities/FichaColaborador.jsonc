{
  "name": "FichaColaborador",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "cpf": {
      "type": "string",
      "description": "CPF"
    },
    "rg": {
      "type": "string",
      "description": "RG"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "matricula": {
      "type": "string",
      "description": "Matr\u00edcula do colaborador"
    },
    "data_admissao": {
      "type": "string",
      "format": "date",
      "description": "Data de admiss\u00e3o"
    },
    "data_demissao": {
      "type": "string",
      "format": "date",
      "description": "Data de demiss\u00e3o (se aplic\u00e1vel)"
    },
    "funcao_id": {
      "type": "string",
      "description": "ID da fun\u00e7\u00e3o"
    },
    "funcao_name": {
      "type": "string",
      "description": "Nome da fun\u00e7\u00e3o"
    },
    "setor_id": {
      "type": "string",
      "description": "ID do setor"
    },
    "setor_name": {
      "type": "string",
      "description": "Nome do setor"
    },
    "unidade_id": {
      "type": "string",
      "description": "ID da unidade"
    },
    "unidade_name": {
      "type": "string",
      "description": "Nome da unidade"
    },
    "regime_contratacao": {
      "type": "string",
      "enum": [
        "clt",
        "pj",
        "estagio",
        "temporario"
      ],
      "default": "clt",
      "description": "Regime de contrata\u00e7\u00e3o"
    },
    "cep": {
      "type": "string",
      "description": "CEP residencial"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o residencial"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "ferias",
        "afastado"
      ],
      "default": "ativo"
    }
  },
  "required": [
    "full_name",
    "cpf"
  ]
}