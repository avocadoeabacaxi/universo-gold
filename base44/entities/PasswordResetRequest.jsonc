{
  "name": "PasswordResetRequest",
  "type": "object",
  "properties": {
    "matricula": {
      "type": "string",
      "description": "Matr\u00edcula do colaborador que solicita reset"
    },
    "full_name": {
      "type": "string",
      "description": "Nome informado pelo solicitante"
    },
    "identifier": {
      "type": "string",
      "description": "E-mail ou login usado para acessar"
    },
    "note": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o do solicitante"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "rejected"
      ],
      "default": "pending",
      "description": "Status do pedido de reset"
    },
    "handled_by": {
      "type": "string",
      "description": "Nome de quem tratou o pedido"
    }
  },
  "required": [
    "matricula"
  ]
}